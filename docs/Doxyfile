# Doxygen configuration for Godot Gaussian Splatting
#
# Relative paths below resolve against doxygen's WORKING DIRECTORY, not against
# this file's directory. scripts/build_documentation.py runs `doxygen docs/Doxyfile`
# from the repository root, so every path here is repository-root-relative.
# (INPUT used to read `../modules/gaussian_splatting ../scripts`, which pointed
# outside the checkout: doxygen warned the input did not exist and published an
# empty C++ API.)
PROJECT_NAME           = "Godot Gaussian Splatting"
PROJECT_NUMBER         =
OUTPUT_DIRECTORY       = docs/api/cpp
GENERATE_HTML          = YES
# LaTeX output was never built into a PDF; it only added unused .tex files to
# the published site.
GENERATE_LATEX         = NO
FULL_PATH_NAMES        = NO
OPTIMIZE_OUTPUT_FOR_C  = NO
OPTIMIZE_OUTPUT_JAVA   = NO
OPTIMIZE_FOR_FORTRAN   = NO
OPTIMIZE_OUTPUT_VHDL   = NO
EXTRACT_ALL            = YES
RECURSIVE              = YES
# scripts/ holds no C++ sources, so the module is the only input.
INPUT                  = modules/gaussian_splatting
FILE_PATTERNS          = *.h *.hpp *.cpp
EXCLUDE_PATTERNS       = */tests/*
WARN_IF_UNDOCUMENTED   = YES
WARNINGS               = YES
# Kept out of docs/ so the (large) warning log is not staged into the public site.
# The repository root always exists; doxygen < 1.9.8 cannot create a missing
# parent directory for this file and falls back to stderr. Gitignored.
WARN_LOGFILE           = doxygen-warnings.log
GENERATE_TREEVIEW      = YES
QUIET                  = NO
JAVADOC_AUTOBRIEF      = YES
ALIASES               += note="@par Note:"
