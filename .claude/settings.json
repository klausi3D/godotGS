{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(/bin/obj/**)",
      "Read(**/.godot/**)",
      "Read(**/*.gsplatcache)",
      "Read(/tests/examples/godot/test_project/scenes/lighting_test.tscn)",
      "Read(/compile_commands.json)",
      "Read(/doc/translations/**)",
      "Read(/editor/translations/**)",
      "Read(/.site/**)",
      "Read(/exhibition/build/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PROJECT_DIR}/scripts/agentic/condense_output.py\" hook",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
