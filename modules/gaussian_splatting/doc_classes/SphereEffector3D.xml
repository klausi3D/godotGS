<?xml version="1.0" encoding="UTF-8" ?>
<class name="SphereEffector3D" inherits="Node3D" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../../doc/class.xsd">
	<brief_description>
		Scene node describing one spherical Gaussian-splat effector.
	</brief_description>
	<description>
		An authorable 3D node that defines a sphere effector - a region that deforms or modulates nearby splats (for example their position and opacity response). Effectors placed in the scene are aggregated and applied by the renderer.
	</description>
	<tutorials>
	</tutorials>
	<methods>
		<method name="get_configuration_warnings" qualifiers="const">
			<return type="PackedStringArray" />
			<description>
			</description>
		</method>
	</methods>
	<members>
		<member name="affect_opacity" type="bool" setter="set_affect_opacity" getter="is_affecting_opacity" default="false">
		</member>
		<member name="affect_position" type="bool" setter="set_affect_position" getter="is_affecting_position" default="true">
		</member>
		<member name="enabled" type="bool" setter="set_enabled" getter="is_enabled" default="false">
		</member>
		<member name="falloff" type="float" setter="set_falloff" getter="get_falloff" default="2.0">
		</member>
		<member name="frequency" type="float" setter="set_frequency" getter="get_frequency" default="2.0">
		</member>
		<member name="layer_mask" type="int" setter="set_layer_mask" getter="get_layer_mask" default="1">
		</member>
		<member name="opacity_strength" type="float" setter="set_opacity_strength" getter="get_opacity_strength" default="1.0">
		</member>
		<member name="priority" type="int" setter="set_priority" getter="get_priority" default="0">
		</member>
		<member name="radius" type="float" setter="set_radius" getter="get_radius" default="0.0">
		</member>
		<member name="scope_mode" type="int" setter="set_scope_mode" getter="get_scope_mode" default="1">
		</member>
		<member name="scope_root" type="NodePath" setter="set_scope_root" getter="get_scope_root" default="NodePath(&quot;&quot;)">
		</member>
		<member name="strength" type="float" setter="set_strength" getter="get_strength" default="0.0">
		</member>
		<member name="target_opacity" type="float" setter="set_target_opacity" getter="get_target_opacity" default="0.0">
		</member>
	</members>
	<constants>
		<constant name="SCOPE_WORLD" value="0" enum="ScopeMode">
		</constant>
		<constant name="SCOPE_SUBTREE" value="1" enum="ScopeMode">
		</constant>
		<constant name="SCOPE_EXPLICIT_ROOT" value="2" enum="ScopeMode">
		</constant>
	</constants>
</class>
